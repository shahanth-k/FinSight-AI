# FinSight AI — Environment Configuration
# Copy this to .env and add your API keys

# ── Google Gemini API Key ──────────────────────────────────────────
# Get your key at: https://aistudio.google.com/app/apikey
# If not set, the system uses rule-based synthesis (still works!)
GEMINI_API_KEY=your_gemini_api_key_here

# ── NewsAPI Key ─────────────────────────────────────────────────────
# Get your FREE key at: https://newsapi.org/register
# Free tier: 100 requests/day, 30-day news history
# If not set, news section will be hidden (technical analysis still runs)
NEWS_API_KEY=your_newsapi_key_here
